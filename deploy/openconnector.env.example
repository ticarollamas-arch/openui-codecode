# URL pública HTTPS do OpenConnector (ex.: https://connect.seudominio.com.br)
OOMOL_CONNECT_ORIGIN=https://connect.seudominio.com.br

# Gere valores longos e aleatórios. Nunca coloque estes valores no frontend.
OOMOL_CONNECT_ADMIN_TOKEN=SUBSTITUA_POR_UM_TOKEN_ADMIN_FORTE
OOMOL_CONNECT_ENCRYPTION_KEY=SUBSTITUA_POR_UMA_CHAVE_DE_CRIPTOGRAFIA_FORTE

# Opcional: restrinja ações/proxies de acordo com a política do produto.
# OOMOL_CONNECT_ALLOWED_ACTIONS=
# OOMOL_CONNECT_BLOCKED_ACTIONS=
# OOMOL_CONNECT_ALLOWED_PROXIES=
# OOMOL_CONNECT_BLOCKED_PROXIES=*

# Configure também na Vercel (server-side):
# OPENCONNECTOR_BASE_URL=https://connect.seudominio.com.br
# OPENCONNECTOR_ADMIN_TOKEN=mesmo-token-admin-acima
# OPENCONNECTOR_CONSOLE_URL=https://connect.seudominio.com.br
