# Exemplo para connect.seudominio.com.br.
# O serviço OpenConnector permanece em 127.0.0.1:30100.
server {
    listen 80;
    server_name connect.seudominio.com.br;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name connect.seudominio.com.br;

    # Configure os caminhos reais do certificado Let's Encrypt.
    ssl_certificate /etc/letsencrypt/live/connect.seudominio.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/connect.seudominio.com.br/privkey.pem;

    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:30100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
