# Credenciais administradas exclusivamente no servidor
APP_ACCESS_TOKEN=
GROQ_API_KEY=
GITHUB_TOKEN=

# Motor de execução privado
EXECUTOR_SERVER_URL=http://127.0.0.1:4096
EXECUTOR_SERVER_PASSWORD=
EXECUTOR_PROVIDER_ID=
EXECUTOR_SKILLS_DIR=

# 9Router compartilhado (configurado pela administração)
NINEROUTER_BASE_URL=http://127.0.0.1:20128
NINEROUTER_API_KEY=
NINEROUTER_DEFAULT_COMBO=openui-coding

# Armazenamento opcional compatível com S3
S3_ACCESS_KEY_ID=
S3_BUCKET=
S3_ENDPOINT=
S3_SECRET_ACCESS_KEY=

# Publicação GitHub desativada até existir autenticação/autorização por usuário
GITHUB_PUBLISH_ENABLED=false
